{% extends 'base.html.twig' %}

{% block title %}Coordinator Dashboard — INTERNSYNC AI{% endblock %}
{% block page_title %}Analytics Dashboard{% endblock %}
{% block page_subtitle %}Program-wide OJT insights and metrics{% endblock %}

{% block content %}

<div class="stats-grid">
    <div class="stat-card"><span class="stat-icon"><i class="fa-solid fa-users" aria-hidden="true"></i></span><div class="stat-value" id="s-students">—</div><div class="stat-label">Total Students</div></div>
    <div class="stat-card"><span class="stat-icon"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i></span><div class="stat-value" id="s-assignments">—</div><div class="stat-label">Active Assignments</div></div>
    <div class="stat-card"><span class="stat-icon"><i class="fa-solid fa-chart-column" aria-hidden="true"></i></span><div class="stat-value" id="s-completion">—%</div><div class="stat-label">Avg Completion Rate</div></div>
    <div class="stat-card"><span class="stat-icon"><i class="fa-solid fa-star" aria-hidden="true"></i></span><div class="stat-value" id="s-clarity">—</div><div class="stat-label">Avg Clarity Score</div></div>
</div>

<div class="charts-grid">
    <div class="card">
        <div class="card-header"><div class="card-title"><i class="fa-solid fa-tags" aria-hidden="true"></i> Top Skill Tags</div><div class="card-subtitle">Frequency across all logs</div></div>
        <div class="chart-container" style="height:260px;"><canvas id="chart-skills"></canvas></div>
    </div>
    <div class="card">
        <div class="card-header"><div class="card-title"><i class="fa-solid fa-chart-pie" aria-hidden="true"></i> Log Status</div><div class="card-subtitle">Distribution overview</div></div>
        <div class="chart-container" style="height:260px;"><canvas id="chart-status"></canvas></div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <div><div class="card-title"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i> Student Progress</div><div class="card-subtitle">OJT hours completion per student</div></div>
    </div>
    <div id="student-progress-list">
        <div class="empty-state" style="padding:32px;"><div class="spinner spinner-lg"></div></div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="card-title"><i class="fa-solid fa-file-lines" aria-hidden="true"></i> All Assignments</div>
        <input type="text" id="search-students" class="form-control"
            placeholder="Search students…"
            style="width:220px;padding:7px 12px;font-size:13px;">
    </div>
    <div class="table-wrapper">
        <table class="table" id="students-table">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Company</th>
                    <th>Hours</th>
                    <th>Progress</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="students-tbody">
                <tr><td colspan="5" style="text-align:center;padding:24px;color:var(--text-muted);">Loading…</td></tr>
            </tbody>
        </table>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
let skillChart, statusChart;

document.addEventListener('DOMContentLoaded', async () => {
    const jwt = window.getJwt();
    if (!jwt) { window.location.href = '/login'; return; }

    try {
        const [dashRes, assignRes] = await Promise.all([
            fetch('/api/dashboard', { headers: { 'Authorization': 'Bearer ' + jwt } }),
            fetch('/api/assignments', { headers: { 'Authorization': 'Bearer ' + jwt } })
        ]);
        const dash = await dashRes.json();
        const assignmentsResponse = await assignRes.json();
        const assigns = Array.isArray(assignmentsResponse) ? assignmentsResponse : (assignmentsResponse.assignments || []);

        // Stats
        document.getElementById('s-students').textContent   = dash.totalStudents || 0;
        document.getElementById('s-assignments').textContent= dash.activeAssignments || 0;
        document.getElementById('s-completion').textContent = Number(dash.averageCompletionPercentage ?? dash.avgCompletionRate ?? 0).toFixed(0) + '%';
        document.getElementById('s-clarity').textContent    = Number(dash.averageClarityScore ?? dash.avgClarityScore ?? 0).toFixed(1);

        // Skill tags chart
        const skillData = dash.skillTagFrequency || {};
        const skillLabels = Object.keys(skillData).slice(0,10);
        const skillValues = skillLabels.map(k => skillData[k]);
        renderSkillChart(skillLabels, skillValues);

        // Status chart
        renderStatusChart(dash.pendingLogs || 0, dash.approvedLogs || 0, dash.rejectedLogs || 0);

        // Student progress
        renderStudentProgress(assigns);

        // Assignments table
        renderTable(assigns);

        document.getElementById('search-students').addEventListener('input', e => {
            const q = e.target.value.toLowerCase();
            renderTable(assigns.filter(a =>
                (a.studentName||'').toLowerCase().includes(q) ||
                (a.companyName||'').toLowerCase().includes(q)
            ));
        });

    } catch(e) {
        console.error(e);
    }
});

function renderSkillChart(labels, values) {
    const ctx = document.getElementById('chart-skills').getContext('2d');
    if (skillChart) skillChart.destroy();
    skillChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels.length ? labels : ['No data'],
            datasets: [{
                data: values.length ? values : [0],
                backgroundColor: 'rgba(79,70,229,0.7)',
                borderColor: '#4F46E5',
                borderWidth: 1,
                borderRadius: 6,
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { ticks: { color: '#94a3b8', font: { size: 11 } }, grid: { color: 'rgba(148,163,184,0.08)' } },
                y: { ticks: { color: '#94a3b8', font: { size: 11 }, stepSize: 1 }, grid: { color: 'rgba(148,163,184,0.08)' } }
            }
        }
    });
}

function renderStatusChart(pending, approved, rejected) {
    const ctx = document.getElementById('chart-status').getContext('2d');
    if (statusChart) statusChart.destroy();
    statusChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Pending', 'Approved', 'Rejected'],
            datasets: [{
                data: [pending, approved, rejected],
                backgroundColor: ['rgba(245,158,11,0.8)', 'rgba(16,185,129,0.8)', 'rgba(239,68,68,0.8)'],
                borderColor: ['#F59E0B','#10B981','#EF4444'],
                borderWidth: 2
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { color: '#94a3b8', padding: 16, font: { size: 12 } } }
            },
            cutout: '65%'
        }
    });
}

function renderStudentProgress(assigns) {
    const container = document.getElementById('student-progress-list');
    if (!assigns.length) {
        container.innerHTML = '<div class="empty-state" style="padding:32px;"><div class="empty-state-icon"><i class="fa-solid fa-users" aria-hidden="true"></i></div><div class="empty-state-title">No assignments yet</div></div>';
        return;
    }
    container.innerHTML = assigns.map(a => {
        const pct = a.requiredHours > 0 ? Math.min(100, Math.round((a.hoursCompleted / a.requiredHours) * 100)) : 0;
        return `
        <div style="display:grid; grid-template-columns:180px 1fr 60px; align-items:center; gap:16px; padding:14px 0; border-bottom:1px solid var(--border);">
            <div>
                <div class="font-semibold text-sm">${escHtml(a.studentName||'—')}</div>
                <div class="text-xs text-muted">${escHtml(a.companyName||'—')}</div>
            </div>
            <div>
                <div class="progress-wrap"><div class="progress-bar" style="width:${pct}%"></div></div>
            </div>
            <div class="text-sm font-semibold" style="text-align:right;">${pct}%</div>
        </div>`;
    }).join('');
}

function renderTable(assigns) {
    const tbody = document.getElementById('students-tbody');
    if (!assigns.length) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:24px;color:var(--text-muted);">No assignments found</td></tr>';
        return;
    }
    tbody.innerHTML = assigns.map(a => {
        const pct = a.requiredHours > 0 ? Math.min(100, Math.round((a.hoursCompleted / a.requiredHours) * 100)) : 0;
        return `<tr>
            <td><div class="flex gap-2 items-center">
                <div class="user-avatar" style="width:32px;height:32px;font-size:12px;">${(a.studentName||'S').charAt(0)}</div>
                <span>${escHtml(a.studentName||'—')}</span>
            </div></td>
            <td>${escHtml(a.companyName||'—')}</td>
            <td>${a.hoursCompleted||0} / ${a.requiredHours||0}h</td>
            <td style="min-width:120px;">
                <div class="progress-wrap" style="height:6px;"><div class="progress-bar" style="width:${pct}%"></div></div>
            </td>
            <td><span class="badge badge-${(a.status||'active').toLowerCase()}">${a.status||'ACTIVE'}</span></td>
        </tr>`;
    }).join('');
}

function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
</script>
{% endblock %}
