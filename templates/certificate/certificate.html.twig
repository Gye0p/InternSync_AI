<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>OJT Completion Certificate</title>
    <style>
        @page {
            margin: 0;
        }
        body {
            font-family: Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 60px 80px;
            color: #1a1a2e;
            background: #ffffff;
        }
        .certificate-border {
            border: 3px solid #16213e;
            padding: 50px 60px;
            min-height: 400px;
            text-align: center;
        }
        .header {
            font-size: 14px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #e94560;
            margin-bottom: 10px;
        }
        .title {
            font-size: 36px;
            font-weight: bold;
            color: #16213e;
            margin: 10px 0 30px;
        }
        .subtitle {
            font-size: 14px;
            color: #555;
            margin-bottom: 25px;
        }
        .student-name {
            font-size: 28px;
            font-weight: bold;
            color: #e94560;
            border-bottom: 2px solid #16213e;
            display: inline-block;
            padding: 5px 40px 10px;
            margin: 10px 0 25px;
        }
        .details {
            font-size: 13px;
            color: #333;
            line-height: 2;
            margin: 20px 0;
        }
        .details strong {
            color: #16213e;
        }
        .footer {
            margin-top: 50px;
            display: table;
            width: 100%;
        }
        .footer-col {
            display: table-cell;
            width: 50%;
            text-align: center;
            padding-top: 40px;
        }
        .signature-line {
            border-top: 1px solid #333;
            width: 200px;
            margin: 0 auto 5px;
        }
        .signature-label {
            font-size: 11px;
            color: #777;
        }
        .date-issued {
            font-size: 11px;
            color: #999;
            margin-top: 30px;
        }
    </style>
</head>
<body>
    <div class="certificate-border">
        <div class="header">InternSync AI</div>
        <div class="title">Certificate of Completion</div>
        <div class="subtitle">This certificate is proudly presented to</div>

        <div class="student-name">{{ student.name }}</div>

        <div class="details">
            for successfully completing the On-the-Job Training program at<br>
            <strong>{{ assignment.companyName }}</strong><br><br>
            Total Hours Completed: <strong>{{ assignment.hoursCompleted }} / {{ assignment.requiredHours }} hours</strong><br>
            Training Period: <strong>{{ assignment.startDate|date('F j, Y') }} — {{ assignment.endDate ? assignment.endDate|date('F j, Y') : 'Present' }}</strong>
        </div>

        <div class="footer">
            <div class="footer-col">
                <div class="signature-line"></div>
                <div class="signature-label">{{ supervisor.name }}<br>OJT Supervisor</div>
            </div>
            <div class="footer-col">
                <div class="signature-line"></div>
                <div class="signature-label">OJT Coordinator<br>InternSync AI</div>
            </div>
        </div>

        <div class="date-issued">
            Issued on {{ generatedAt|date('F j, Y') }}
        </div>
    </div>
</body>
</html>
