{# templates/certificate/certificate.html.twig

   Rendered to PDF via DomPDF — deliberately flat (no blur, gradients,
   flexbox, or grid) since DomPDF only reliably supports basic CSS:
   tables, borders, padding, text properties.

   Expected variables:
     assignment   - OjtAssignment entity
     certificate  - Certificate entity (id)
     student      - User entity
     supervisor   - User entity
     generatedAt  - DateTimeImmutable
#}
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  @page {
    margin: 0;
    size: A4 landscape;
  }
  body {
    margin: 0;
    padding: 0;
    font-family: Helvetica, Arial, sans-serif;
    color: #1a1a2e;
  }
  .certificate {
    width: 100%;
    height: 100%;
    padding: 50px 70px;
    border: 3px solid #4F46E5;
  }
  .inner-border {
    border: 1px solid #06B6D4;
    padding: 40px 60px;
    text-align: center;
  }
  .brand {
    font-size: 14px;
    letter-spacing: 3px;
    color: #4F46E5;
    font-weight: bold;
    text-transform: uppercase;
    margin-bottom: 30px;
  }
  .title {
    font-size: 34px;
    font-weight: bold;
    margin: 10px 0 5px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .subtitle {
    font-size: 13px;
    color: #555555;
    margin-bottom: 35px;
  }
  .presented-to {
    font-size: 12px;
    color: #888888;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  .student-name {
    font-size: 30px;
    font-weight: bold;
    color: #4F46E5;
    border-bottom: 1px solid #cccccc;
    padding: 0 40px 8px 40px;
  }
  .description {
    font-size: 13px;
    color: #333333;
    line-height: 1.6;
    width: 480px;
    margin: 0 auto 35px auto;
  }
  .description strong {
    color: #1a1a2e;
  }
  .details-table {
    width: 100%;
    margin: 0 auto 40px auto;
    border-collapse: collapse;
  }
  .details-table td {
    text-align: center;
    padding: 0 15px;
    border-right: 1px solid #dddddd;
  }
  .details-table td.last {
    border-right: none;
  }
  .detail-label {
    display: block;
    font-size: 10px;
    color: #888888;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
  }
  .detail-value {
    display: block;
    font-size: 15px;
    font-weight: bold;
  }
  .footer-table {
    width: 100%;
    margin-top: 50px;
  }
  .footer-table td {
    width: 50%;
    text-align: center;
    vertical-align: bottom;
  }
  .signature-line {
    border-top: 1px solid #1a1a2e;
    width: 200px;
    margin: 0 auto 6px auto;
  }
  .signature-label {
    font-size: 10px;
    color: #888888;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .verification {
    margin-top: 30px;
    font-size: 9px;
    color: #aaaaaa;
  }
</style>
</head>
<body>
  <div class="certificate">
    <div class="inner-border">
      <div class="brand">InternSync AI</div>
      <div class="title">Certificate of completion</div>
      <div class="subtitle">On-the-job training program</div>

      <div class="presented-to">This certificate is proudly presented to</div>
      <table style="margin: 10px auto 25px auto;">
        <tr>
          <td class="student-name">{{ student.name }}</td>
        </tr>
      </table>

      <div class="description">
        for successfully completing <strong>{{ assignment.hoursCompleted }} hours</strong>
        of On-the-Job Training at <strong>{{ assignment.companyName }}</strong>,
        fulfilling all requirements of the program.
      </div>

      <table class="details-table">
        <tr>
          <td>
            <span class="detail-label">Start date</span>
            <span class="detail-value">{{ assignment.startDate|date('M d, Y') }}</span>
          </td>
          <td>
            <span class="detail-label">Completion date</span>
            <span class="detail-value">{{ assignment.endDate|date('M d, Y') }}</span>
          </td>
          <td class="last">
            <span class="detail-label">Total hours</span>
            <span class="detail-value">{{ assignment.hoursCompleted }}</span>
          </td>
        </tr>
      </table>

      <table class="footer-table">
        <tr>
          <td>
            <div class="signature-line"></div>
            <div class="signature-label">{{ supervisor.name }}</div>
            <div class="signature-label">Company supervisor</div>
          </td>
          <td>
            <div class="signature-line"></div>
            <div class="signature-label">OJT coordinator</div>
            <div class="signature-label">InternSync AI</div>
          </td>
        </tr>
      </table>

      <div class="verification">
        Verification ID: {{ certificate.id }}-{{ assignment.id }} &nbsp;&middot;&nbsp; Issued {{ generatedAt|date('M d, Y') }}
      </div>
    </div>
  </div>
</body>
</html>
