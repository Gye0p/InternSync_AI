{% extends 'base.html.twig' %}

{% block title %}Supervisor Dashboard — INTERNSYNC AI{% endblock %}
{% block page_title %}Supervisor Dashboard{% endblock %}
{% block page_subtitle %}Monitor and review student progress{% endblock %}

{% block header_actions %}
    <a href="/supervisor/approvals" class="btn btn-primary btn-sm">✅ Review Queue</a>
{% endblock %}

{% block content %}
<div class="stats-grid">
    <div class="stat-card"><span class="stat-icon">👥</span><div class="stat-value" id="s-students">—</div><div class="stat-label">Assigned Students</div></div>
    <div class="stat-card"><span class="stat-icon">⏳</span><div class="stat-value" id="s-pending">—</div><div class="stat-label">Pending Reviews</div></div>
    <div class="stat-card"><span class="stat-icon">✅</span><div class="stat-value" id="s-approved">—</div><div class="stat-label">Total Approved</div></div>
    <div class="stat-card"><span class="stat-icon">📊</span><div class="stat-value" id="s-total">—</div><div class="stat-label">Total Logs</div></div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
    <div class="card">
        <div class="card-header">
            <div class="card-title">⏳ Pending Approvals</div>
            <a href="/supervisor/approvals" class="btn btn-outline btn-sm">View All</a>
        </div>
        <div id="pending-list">
            <div class="empty-state" style="padding:32px;"><div class="spinner spinner-lg"></div></div>
        </div>
    </div>
    <div class="card">
        <div class="card-header"><div class="card-title">📈 Student Overview</div></div>
        <div id="student-list">
            <div class="empty-state" style="padding:32px;"><div class="spinner spinner-lg"></div></div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', async () => {
    const jwt = window.getJwt();
    if (!jwt) { window.location.href = '/login'; return; }
    try {
        const [logsRes, assignRes] = await Promise.all([
            fetch('/api/logs', { headers: { 'Authorization': 'Bearer ' + jwt } }),
            fetch('/api/assignments', { headers: { 'Authorization': 'Bearer ' + jwt } })
        ]);
        const logs   = await logsRes.json();
        const assigns = await assignRes.json();

        const pending  = logs.filter(l => l.status === 'PENDING');
        const approved = logs.filter(l => l.status === 'APPROVED');

        document.getElementById('s-pending').textContent  = pending.length;
        document.getElementById('s-approved').textContent = approved.length;
        document.getElementById('s-total').textContent    = logs.length;
        document.getElementById('s-students').textContent = assigns.length;

        // Pending list
        const pendingEl = document.getElementById('pending-list');
        if (!pending.length) {
            pendingEl.innerHTML = '<div class="empty-state" style="padding:32px;"><div class="empty-state-icon">🎉</div><div class="empty-state-title">All Reviewed!</div><div class="empty-state-desc">No pending logs right now.</div></div>';
        } else {
            pendingEl.innerHTML = pending.slice(0,5).map(log => `
            <div class="log-card" style="margin-bottom:10px; padding:14px;">
                <div class="flex justify-between items-center mb-1">
                    <span class="font-semibold text-sm">${escHtml(log.studentName||'Student')}</span>
                    <span class="badge badge-pending">PENDING</span>
                </div>
                <div class="text-sm text-muted" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml((log.content||'').substring(0,80))}…</div>
                <div class="flex gap-2 mt-2">
                    <a href="/supervisor/approvals" class="btn btn-success btn-sm">Review</a>
                </div>
            </div>`).join('');
        }

        // Student overview
        const studentEl = document.getElementById('student-list');
        if (!assigns.length) {
            studentEl.innerHTML = '<div class="empty-state" style="padding:32px;"><div class="empty-state-icon">👥</div><div class="empty-state-title">No Students Yet</div></div>';
        } else {
            studentEl.innerHTML = assigns.map(a => {
                const pct = a.requiredHours > 0 ? Math.min(100, Math.round((a.hoursCompleted/a.requiredHours)*100)) : 0;
                return `
                <div style="padding:14px 0; border-bottom:1px solid var(--border);">
                    <div class="flex justify-between items-center mb-2">
                        <div class="flex gap-2 items-center">
                            <div class="user-avatar" style="width:32px;height:32px;font-size:12px;">${(a.studentName||'S').charAt(0)}</div>
                            <div>
                                <div class="font-semibold text-sm">${escHtml(a.studentName||'—')}</div>
                                <div class="text-xs text-muted">${escHtml(a.companyName||'—')}</div>
                            </div>
                        </div>
                        <span class="text-sm font-bold">${pct}%</span>
                    </div>
                    <div class="progress-wrap"><div class="progress-bar" style="width:${pct}%"></div></div>
                    <div class="text-xs text-muted mt-1">${a.hoursCompleted||0}h / ${a.requiredHours||0}h</div>
                </div>`;
            }).join('');
        }
    } catch(e) { console.error(e); }
});

function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
</script>
<style>@media(max-width:768px){.dashboard-grid{grid-template-columns:1fr!important}}</style>
{% endblock %}
